    <!-- Feature explanations -->
    <string name="help_dialog_dismiss">UNDERSTOOD</string>
    <string name="help_pause_duration_title">PAUSE DURATION (INHALE AND EXHALE)</string>
    <string name="help_pause_duration_desc">A mindful breathing pause before opening the application. It helps interrupt the automatic impulse and decide whether you truly need to use the app right now. The timer is split equally into inhale and exhale phases.</string>
    <string name="help_reintervention_title">RE-INTERVENTION</string>
    <string name="help_reintervention_desc">Continuous session time limit. If enabled, the breathing screen reappears after the specified interval of app usage, reminding you to take a mindful break.</string>
    <string name="help_quick_return_title">QUICK RETURN GRACE</string>
    <string name="help_quick_return_desc">The grace window after exiting the app during which you can return without another breathing intervention (e.g. to answer a phone call or copy a verification code).</string>
    <string name="help_backoff_title">EXPONENTIAL GROWTH</string>
    <string name="help_backoff_desc">Each confirmed entry into the application within the rolling window increases the breathing pause duration by the configured percentage. This gently curbs the habit of compulsive checks. Exiting during breathing does not increase the timer.</string>
    <string name="help_quick_lock_title">QUICK LOCK</string>
    <string name="help_quick_lock_desc">Instantly hard-blocks access to the application for the chosen duration (15m, 30m, 1h, or 2h). During an active hard block, entering via breathing is completely disabled.</string>

