{
  "manifest_version": 3,
  "name": "wattim 🌿 — Осознанный цифровой детокс",
  "version": "1.0.0",
  "description": "Осознанные дыхательные паузы, экспоненциальное сдерживание и защита от думскроллинга.",
  "author": "wattim team",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "wattim 🌿",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wattim@mindful.extension",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["sentinel/sentinel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "intervention/*",
        "common/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
